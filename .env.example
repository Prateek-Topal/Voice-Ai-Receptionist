# Copy this file to .env.local and fill in real values.
#   Windows:   copy .env.example .env.local
#   mac/Linux: cp .env.example .env.local

# --- LiveKit Cloud (https://cloud.livekit.io → your project → Settings → API Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# --- Agent identity (must match the name you type in the LiveKit Agent Console)
AGENT_NAME=receptionist

# --- Speech-to-text: "deepgram" (direct, Day 2) or "inference" (LiveKit-hosted, Day 1)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_key
DEEPGRAM_MODEL=nova-3
# "en" works everywhere. Try "en-IN" for better Indian-English accuracy.
DEEPGRAM_LANGUAGE=en

# --- LLM: "groq" (direct, Day 2) or "inference" (LiveKit-hosted, Day 1)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key
# Production models on Groq (Oct 2026): openai/gpt-oss-20b (fastest), openai/gpt-oss-120b (smarter)
GROQ_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.4

# --- Fallback models used when a provider above is set to "inference"
STT_MODEL=deepgram/nova-3-general
STT_LANGUAGE=en
LLM_MODEL=google/gemma-4-31b-it

# --- Text-to-speech (LiveKit Inference until Day 3, then ElevenLabs)
TTS_MODEL=fishaudio/s2.1-pro
TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a

# --- App
BUSINESS_CONFIG=config/business.yaml
LOG_LEVEL=INFO

# --- Added on later days (leave empty for now)
ELEVENLABS_API_KEY=
GOOGLE_CALENDAR_ID=
