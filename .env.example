# Copy this file to .env.local and fill in real values.
#   Windows:   copy .env.example .env.local
#   mac/Linux: cp .env.example .env.local

# --- LiveKit Cloud (https://cloud.livekit.io → your project → Settings → API Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# --- Agent identity (must match the name you type in the LiveKit Agent Console)
AGENT_NAME=receptionist

# --- Speech-to-text: "deepgram" (direct, Day 2) or "inference" (LiveKit-hosted, Day 1)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_key
DEEPGRAM_MODEL=nova-3
# "en" works everywhere. Try "en-IN" for better Indian-English accuracy.
DEEPGRAM_LANGUAGE=en

# --- LLM: "groq" (direct, Day 2) or "inference" (LiveKit-hosted, Day 1)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key
# Production models on Groq (Oct 2026): openai/gpt-oss-20b (fastest), openai/gpt-oss-120b (smarter)
GROQ_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.4
# If Groq fails or hits its free-tier rate limit (8k tokens/min), answer with
# LiveKit Inference instead of going silent.
LLM_FALLBACK=true
# Preemptive generation starts the LLM before the caller finishes. Faster, but roughly
# doubles LLM requests. Keep false on Groq's free tier.
PREEMPTIVE_GENERATION=false

# --- Fallback models used when a provider above is set to "inference"
STT_MODEL=deepgram/nova-3-general
STT_LANGUAGE=en
LLM_MODEL=google/gemma-4-31b-it

# --- Text-to-speech: "elevenlabs" (direct, Day 3) or "inference" (LiveKit-hosted)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_key
# Voice ID from elevenlabs.io → Voices (click a voice → copy its ID)
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
# eleven_flash_v2_5 = lowest latency (recommended for phone calls)
ELEVENLABS_MODEL=eleven_flash_v2_5
# 0.7 (slow) – 1.2 (fast)
VOICE_SPEED=1.0
# 0.0 (expressive) – 1.0 (steady)
VOICE_STABILITY=0.5

# Fallback TTS used when TTS_PROVIDER=inference
TTS_MODEL=fishaudio/s2.1-pro
TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a

# --- Turn-taking (Day 3). Defaults are tuned for phone calls.
# How long to wait after the caller stops talking before replying (seconds).
# "fixed" is predictable. "dynamic" adapts to the caller but can drift upward after long silences.
ENDPOINTING_MODE=fixed
MIN_ENDPOINTING_DELAY=0.5
MAX_ENDPOINTING_DELAY=1.5
# Caller speech shorter than this (seconds) won't interrupt Aria (filters coughs, "mm").
MIN_INTERRUPTION_DURATION=0.5
# If an interruption turns out to be noise, Aria resumes after this many seconds.
FALSE_INTERRUPTION_TIMEOUT=1.5
# Seconds of silence before Aria checks "Are you still there?"
USER_AWAY_TIMEOUT=10

# --- App
BUSINESS_CONFIG=config/business.yaml
LOG_LEVEL=INFO

# --- Added on later days (leave empty for now)
GOOGLE_CALENDAR_ID=
