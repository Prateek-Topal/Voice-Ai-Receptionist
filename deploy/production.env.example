# Secrets for the deployed agent. Copy to deploy/production.env (git-ignored), fill in,
# then: lk agent create --secrets-file deploy/production.env \
#         --secret-mount credentials/google-service-account.json
#
# Do NOT put LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET here:
# LiveKit Cloud injects them automatically.

AGENT_NAME=receptionist

STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_FALLBACK=true
PREEMPTIVE_GENERATION=false

TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us

CALENDAR_PROVIDER=google
GOOGLE_CALENDAR_ID=
# The key file is uploaded with --secret-mount and appears at /etc/secrets/<filename>;
# the agent finds it there automatically.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json

MAX_CALL_MINUTES=8
LOG_LEVEL=INFO
